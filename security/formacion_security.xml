<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_formacion" model="ir.module.category">
        <field name="name">Formacion RRHH</field>
        <field name="description">Formacion, personas y puestos SGI</field>
        <field name="sequence">52</field>
    </record>
    <record id="group_formacion_user" model="res.groups">
        <field name="name">Formacion Usuario</field>
        <field name="comment">Gestiona personas, puestos y plan de formacion</field>
    </record>
    <record id="group_formacion_manager" model="res.groups">
        <field name="name">Formacion Gestor</field>
        <field name="implied_ids" eval="[(4, ref('group_formacion_user'))]"/>
        <field name="comment">Configura catalogos y cierra procesos</field>
    </record>
</odoo>
