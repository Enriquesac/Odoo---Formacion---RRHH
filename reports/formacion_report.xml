<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_accion_doc">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="text-center"><span t-field="o.name"/></h2>
                <table class="table table-sm table-bordered mt-2">
                    <tr><td><strong>Tipo</strong></td><td><span t-field="o.tipo"/></td></tr>
                    <tr><td><strong>Estado</strong></td><td><span t-field="o.estado"/></td></tr>
                    <tr><td><strong>Fecha prevista</strong></td><td><span t-field="o.fecha_prevista"/></td></tr>
                    <tr><td><strong>Horas</strong></td><td><span t-field="o.horas"/></td></tr>
                    <tr><td><strong>Fecha real</strong></td><td><span t-field="o.fecha_real"/> - <span t-field="o.fecha_real_fin"/></td></tr>
                    <tr><td><strong>Eficacia</strong></td><td><span t-field="o.eficacia"/></td></tr>
                </table>
                <div class="mt-3"><strong>Objetivo</strong><div class="border p-2"><span t-field="o.objetivo"/></div></div>
                <div class="mt-3"><strong>Observaciones</strong><div class="border p-2"><span t-field="o.observaciones"/></div></div>
            </div>
        </t>
    </template>
    <template id="report_accion">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="formacion_rrhh.report_accion_doc" t-lang="es_ES"/>
            </t>
        </t>
    </template>
    <record id="action_report_accion" model="ir.actions.report">
        <field name="name">Informe accion</field>
        <field name="model">formacion.accion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">formacion_rrhh.report_accion</field>
        <field name="report_file">formacion_rrhh.report_accion</field>
        <field name="binding_model_id" ref="model_formacion_accion"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_ficha_doc">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="text-center">Ficha: <span t-field="o.nombre_completo"/></h2>
                <table class="table table-sm table-bordered mt-2">
                    <tr><td><strong>Departamento</strong></td><td><span t-field="o.departamento"/></td></tr>
                    <tr><td><strong>Alta</strong></td><td><span t-field="o.fecha_alta"/></td></tr>
                    <tr><td><strong>Baja</strong></td><td><span t-field="o.fecha_baja"/></td></tr>
                    <tr><td><strong>% medio</strong></td><td><span t-field="o.cumplimiento_medio"/></td></tr>
                </table>
                <h3>Valoraciones</h3>
                <table class="table table-sm table-striped">
                    <thead><tr><th>Puesto</th><th>Fecha</th><th>%</th></tr></thead>
                    <tbody>
                        <tr t-foreach="o.valoracion_ids" t-as="v">
                            <td><span t-field="v.puesto_id"/></td>
                            <td><span t-field="v.fecha"/></td>
                            <td><span t-field="v.cumplimiento"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
    <template id="report_ficha">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="formacion_rrhh.report_ficha_doc" t-lang="es_ES"/>
            </t>
        </t>
    </template>
    <record id="action_report_ficha" model="ir.actions.report">
        <field name="name">Ficha persona</field>
        <field name="model">rrhh.persona</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">formacion_rrhh.report_ficha</field>
        <field name="report_file">formacion_rrhh.report_ficha</field>
        <field name="binding_model_id" ref="model_rrhh_persona"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
