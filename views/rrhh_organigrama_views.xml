<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_orgver_list" model="ir.ui.view">
        <field name="name">rrhh.organigrama.version.list</field>
        <field name="model">rrhh.organigrama.version</field>
        <field name="arch" type="xml">
            <list string="Versiones organigrama">
                <field name="name"/>
                <field name="fecha" optional="show"/>
                <field name="motivo" optional="show"/>
                <field name="puesto_count" string="Puestos"/>
                <field name="persona_count" string="Personas"/>
            </list>
        </field>
    </record>
    <record id="view_orgver_form" model="ir.ui.view">
        <field name="name">rrhh.organigrama.version.form</field>
        <field name="model">rrhh.organigrama.version</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_snapshot" string="Capturar snapshot" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="fecha"/>
                        <field name="motivo"/>
                    </group>
                    <field name="snapshot" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_orgver" model="ir.actions.act_window">
        <field name="name">Organigrama versiones</field>
        <field name="res_model">rrhh.organigrama.version</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
