<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asignacion_search" model="ir.ui.view">
        <field name="name">rrhh.asignacion.search</field>
        <field name="model">rrhh.asignacion</field>
        <field name="arch" type="xml">
            <search>
                <field name="persona_id"/>
                <field name="tipo"/>
                <field name="estado"/>
                <filter string="Asignados" name="f_asig" domain="[('estado','=','asignado')]"/>
            </search>
        </field>
    </record>
    <record id="view_asignacion_list" model="ir.ui.view">
        <field name="name">rrhh.asignacion.list</field>
        <field name="model">rrhh.asignacion</field>
        <field name="arch" type="xml">
            <list string="Asignaciones">
                <field name="persona_id"/>
                <field name="recurso_nombre" string="Recurso"/>
                <field name="tipo" optional="show"/>
                <field name="fecha_entrega" optional="show"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_asignacion_form" model="ir.ui.view">
        <field name="name">rrhh.asignacion.form</field>
        <field name="model">rrhh.asignacion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_devolver" string="Devolver" type="object" class="oe_highlight" invisible="estado != 'asignado'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="asignado,devuelto"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="persona_id"/>
                            <field name="tipo"/>
                            <field name="recurso_nombre"/>
                            <field name="recurso_codigo"/>
                        </group>
                        <group>
                            <field name="fecha_entrega"/>
                            <field name="fecha_devolucion"/>
                        </group>
                    </group>
                    <field name="observaciones"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_asignacion" model="ir.actions.act_window">
        <field name="name">Asignaciones</field>
        <field name="res_model">rrhh.asignacion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
