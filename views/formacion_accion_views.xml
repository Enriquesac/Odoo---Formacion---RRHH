<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_accion_search" model="ir.ui.view">
        <field name="name">formacion.accion.search</field>
        <field name="model">formacion.accion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Titulo"/>
                <field name="tipo"/>
                <field name="estado"/>
                <filter string="Planificadas" name="f_plan" domain="[('estado','=','planificada')]"/>
                <filter string="En curso" name="f_curso" domain="[('estado','=','en_curso')]"/>
                <filter string="Realizadas" name="f_real" domain="[('estado','=','realizada')]"/>
                <filter string="Pendientes eficacia" name="f_pend" domain="[('estado','=','realizada'),('eficacia','=',False)]"/>
            </search>
        </field>
    </record>
    <record id="view_accion_list" model="ir.ui.view">
        <field name="name">formacion.accion.list</field>
        <field name="model">formacion.accion</field>
        <field name="arch" type="xml">
            <list string="Plan" decoration-success="estado == 'realizada'" decoration-info="estado == 'planificada'">
                <field name="name" string="Titulo"/>
                <field name="tipo" optional="show"/>
                <field name="fecha_prevista" optional="show"/>
                <field name="horas" optional="hide"/>
                <field name="estado" widget="badge"/>
                <field name="eficacia" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_accion_pivot" model="ir.ui.view">
        <field name="name">formacion.accion.pivot</field>
        <field name="model">formacion.accion</field>
        <field name="arch" type="xml">
            <pivot string="Dashboard plan">
                <field name="tipo" type="row"/>
                <field name="estado" type="col"/>
                <field name="horas" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_accion_form" model="ir.ui.view">
        <field name="name">formacion.accion.form</field>
        <field name="model">formacion.accion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_en_curso" string="En curso" type="object" class="oe_highlight" invisible="estado != 'planificada'"/>
                    <button name="action_realizada" string="Realizada" type="object" class="oe_highlight" invisible="estado != 'en_curso'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="planificada,en_curso,realizada,cancelada"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Titulo"/>
                            <field name="objetivo"/>
                            <field name="tipo"/>
                            <field name="formador_id"/>
                            <field name="formador_txt" placeholder="Si no esta en catalogo..."/>
                        </group>
                        <group>
                            <field name="fecha_prevista"/>
                            <field name="horas"/>
                            <field name="fecha_real"/>
                            <field name="fecha_real_fin"/>
                            <field name="proceso_id" readonly="1" optional="show"/>
                        </group>
                    </group>
                    <group string="Personas">
                        <field name="persona_prev_ids" widget="many2many_tags"/>
                        <field name="persona_ids" widget="many2many_tags" string="Asistentes"/>
                    </group>
                    <field name="observaciones"/>
                    <group string="Eficacia">
                        <field name="eficacia" widget="radio"/>
                        <field name="criterio_eficacia"/>
                        <field name="valoracion_eficacia"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_accion" model="ir.actions.act_window">
        <field name="name">Plan formacion</field>
        <field name="res_model">formacion.accion</field>
        <field name="view_mode">list,pivot,form</field>
    </record>
</odoo>
